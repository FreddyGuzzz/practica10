# Copia este archivo a .env y ajusta los valores. .env NUNCA se sube a Git.
# Cadena de conexion a MySQL (usuario, contrasena y nombre de la base)
DATABASE_URL="mysql://root:tu_password@localhost:3306/gimnasio"
# Quien tenga este secreto puede firmar tokens validos. Minimo 32 caracteres.
JWT_SECRET="cambia-esto-por-algo-largo-y-aleatorio-de-32-caracteres-o-mas"
# Puerto del servidor (opcional)
PORT=3000
